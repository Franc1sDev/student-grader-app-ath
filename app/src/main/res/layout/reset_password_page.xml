<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_marginBottom="12dp"
    android:layout_marginTop="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginStart="12dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".resetPasswordPage">

    <!-- Scrolls when the keypad is open or the phone is in landscape, so nothing is ever hidden -->
    <ScrollView
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_width="match_parent"
        android:layout_height="0dp">

        <LinearLayout
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="8dp"
                app:srcCompat="@drawable/logo" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Reset Password"
                android:textAlignment="center"
                android:textColor="@color/error_red"
                android:textSize="24sp"
                android:textStyle="bold">

            </TextView>

            <!-- Shows who the password is being reset for (filled in by resetPasswordPage.java) -->
            <TextView
                android:id="@+id/txtvw_resetFor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="20dp"
                android:text="Checking your reset link..."
                android:textAlignment="center"
                android:textColor="?android:textColorPrimary"
                android:textSize="15sp">

            </TextView>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_newPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxStrokeColor="@color/error_red"
                app:boxCornerRadiusBottomStart="20dp"
                app:boxCornerRadiusTopStart="20dp"
                app:boxCornerRadiusBottomEnd="20dp"
                app:boxCornerRadiusTopEnd="20dp"
                app:endIconMode="password_toggle"
                app:errorEnabled="true"
                app:errorIconDrawable="@null">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtxt_newPassword"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:autofillHints="newPassword"
                    android:hint="New Password"
                    android:imeOptions="actionNext"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:textAlignment="center"
                    android:textSize="20sp">

                </com.google.android.material.textfield.TextInputEditText>

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="12dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_confirmNewPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxStrokeColor="@color/error_red"
                app:boxCornerRadiusBottomStart="20dp"
                app:boxCornerRadiusTopStart="20dp"
                app:boxCornerRadiusBottomEnd="20dp"
                app:boxCornerRadiusTopEnd="20dp"
                app:endIconMode="password_toggle"
                app:errorEnabled="true"
                app:errorIconDrawable="@null">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtxt_confirmNewPassword"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:autofillHints="newPassword"
                    android:hint="Confirm New Password"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:textAlignment="center"
                    android:textSize="20sp">

                </com.google.android.material.textfield.TextInputEditText>

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="*Reset Password will turn green if details correct*"
                android:textAlignment="center"
                android:textColor="@android:color/holo_green_dark"
                android:textStyle="bold">

            </TextView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_resetPassword"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:backgroundTint="@color/material_dynamic_neutral80"
                android:enabled="false"
                android:text="Reset Password"
                android:textSize="20sp"
                android:textStyle="bold">

            </com.google.android.material.button.MaterialButton>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="20dp">

            </TextView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cancelResetPassword"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:backgroundTint="@color/error_red"
                android:text="Cancel"
                android:textSize="20sp"
                android:textStyle="bold">

            </com.google.android.material.button.MaterialButton>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="16dp">

            </TextView>

            <TextView
                android:id="@+id/txtvw_backToLogin"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="I remember my password, let me in"
                android:textColor="@color/error_red"
                android:textSize="16sp"
                android:textStyle="bold">

            </TextView>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
