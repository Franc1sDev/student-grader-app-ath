<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_marginBottom="12dp"
    android:layout_marginTop="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginStart="12dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".marksPage">

    <!-- Scrolls when the keypad is open or the phone is in landscape, so no field or button is ever hidden -->
    <ScrollView
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_width="match_parent"
        android:layout_height="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Trimester dropdown: Jan-Apr / May-Aug / Sep-Dec + the current year (filled in by marksPage.java).
                 The other fields stay blocked until a trimester is chosen. -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_trimester"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="@color/error_red"
                app:errorEnabled="true">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/actxt_trimester"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Select Trimester"
                    android:inputType="none"
                    android:saveEnabled="false"
                    android:textAlignment="center"
                    android:textColor="?android:textColorPrimary"
                    android:textSize="15sp">

                </com.google.android.material.textfield.MaterialAutoCompleteTextView>

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="8dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_admno"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="@color/error_red"
                app:errorEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtxt_admno"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Student Admno (e.g. 25-0876)"
                    android:inputType="text"
                    android:imeOptions="actionNext"
                    android:maxLines="1"
                    android:textSize="15sp"
                    android:textAlignment="center"
                    android:textColor="?android:textColorPrimary">

                </com.google.android.material.textfield.TextInputEditText>

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="8dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_studentName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="@color/error_red"
                app:errorEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtxt_studentName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Student Name"
                    android:inputType="textPersonName|textCapWords"
                    android:imeOptions="actionNext"
                    android:maxLines="1"
                    android:textSize="15sp"
                    android:textAlignment="center"
                    android:textColor="?android:textColorPrimary">

                </com.google.android.material.textfield.TextInputEditText>

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="8dp" />

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:text="C++:"
                    android:gravity="center_vertical"
                    android:textColor="@color/error_red"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:layout_width="160dp"
                    android:layout_height="56dp">

                </TextView>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_cpp"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    app:boxCornerRadiusBottomEnd="15dp"
                    app:boxCornerRadiusBottomStart="15dp"
                    app:boxCornerRadiusTopEnd="15dp"
                    app:boxCornerRadiusTopStart="15dp"
                    app:boxStrokeColor="@color/error_red"
                    app:errorEnabled="true">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtxt_cpp"
                        android:inputType="numberDecimal"
                        android:imeOptions="actionNext"
                        android:maxLength="6"
                        android:maxLines="1"
                        android:textAlignment="center"
                        android:textColor="?android:textColorPrimary"
                        android:textSize="14sp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                    </com.google.android.material.textfield.TextInputEditText>

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="8dp" />

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:text="Networking:"
                    android:gravity="center_vertical"
                    android:textColor="@color/error_red"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:layout_width="160dp"
                    android:layout_height="56dp">

                </TextView>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_net"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    app:boxCornerRadiusBottomEnd="15dp"
                    app:boxCornerRadiusBottomStart="15dp"
                    app:boxCornerRadiusTopEnd="15dp"
                    app:boxCornerRadiusTopStart="15dp"
                    app:boxStrokeColor="@color/error_red"
                    app:errorEnabled="true">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtxt_net"
                        android:inputType="numberDecimal"
                        android:imeOptions="actionNext"
                        android:maxLength="6"
                        android:maxLines="1"
                        android:textAlignment="center"
                        android:textColor="?android:textColorPrimary"
                        android:textSize="14sp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                    </com.google.android.material.textfield.TextInputEditText>

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="8dp" />

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:text="Android App Dev:"
                    android:gravity="center_vertical"
                    android:textColor="@color/error_red"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:layout_width="160dp"
                    android:layout_height="56dp">

                </TextView>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_android"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    app:boxCornerRadiusBottomEnd="15dp"
                    app:boxCornerRadiusBottomStart="15dp"
                    app:boxCornerRadiusTopEnd="15dp"
                    app:boxCornerRadiusTopStart="15dp"
                    app:boxStrokeColor="@color/error_red"
                    app:errorEnabled="true">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtxt_android"
                        android:inputType="numberDecimal"
                        android:imeOptions="actionNext"
                        android:maxLength="6"
                        android:maxLines="1"
                        android:textAlignment="center"
                        android:textColor="?android:textColorPrimary"
                        android:textSize="14sp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                    </com.google.android.material.textfield.TextInputEditText>

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="8dp" />

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:text="Database:"
                    android:gravity="center_vertical"
                    android:textColor="@color/error_red"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:layout_width="160dp"
                    android:layout_height="56dp">

                </TextView>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_db"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    app:boxCornerRadiusBottomEnd="15dp"
                    app:boxCornerRadiusBottomStart="15dp"
                    app:boxCornerRadiusTopEnd="15dp"
                    app:boxCornerRadiusTopStart="15dp"
                    app:boxStrokeColor="@color/error_red"
                    app:errorEnabled="true">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtxt_db"
                        android:inputType="numberDecimal"
                        android:imeOptions="actionNext"
                        android:maxLength="6"
                        android:maxLines="1"
                        android:textAlignment="center"
                        android:textColor="?android:textColorPrimary"
                        android:textSize="14sp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                    </com.google.android.material.textfield.TextInputEditText>

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="8dp" />

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:text="Cyber Security:"
                    android:gravity="center_vertical"
                    android:textColor="@color/error_red"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:layout_width="160dp"
                    android:layout_height="56dp">

                </TextView>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_cyber"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    app:boxCornerRadiusBottomEnd="15dp"
                    app:boxCornerRadiusBottomStart="15dp"
                    app:boxCornerRadiusTopEnd="15dp"
                    app:boxCornerRadiusTopStart="15dp"
                    app:boxStrokeColor="@color/error_red"
                    app:errorEnabled="true">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtxt_cyber"
                        android:inputType="numberDecimal"
                        android:imeOptions="actionDone"
                        android:maxLength="6"
                        android:maxLines="1"
                        android:textAlignment="center"
                        android:textColor="?android:textColorPrimary"
                        android:textSize="14sp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                    </com.google.android.material.textfield.TextInputEditText>

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_submitAndgrade"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:backgroundTint="@color/material_dynamic_neutral80"
                android:enabled="false"
                android:text="Submit and Grade"
                android:textColor="@color/white"
                android:textSize="18sp">

            </com.google.android.material.button.MaterialButton>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="20dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_clearMarks"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:backgroundTint="@color/error_red"
                android:text="Clear Fields"
                android:textColor="@color/white"
                android:textSize="18sp">

            </com.google.android.material.button.MaterialButton>

        </LinearLayout>

    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
