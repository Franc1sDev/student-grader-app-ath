<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_marginBottom="12dp"
    android:layout_marginTop="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginStart="12dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

    tools:context=".loginPage">

    <!-- Scrolls when the keypad is open or the phone is in landscape, so nothing is ever hidden -->
    <ScrollView
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_width="match_parent"
        android:layout_height="0dp">

        <LinearLayout
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/imageView3"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="24dp"
                app:srcCompat="@drawable/logo" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_staffNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxStrokeColor="@color/error_red"
                app:boxCornerRadiusBottomStart="20dp"
                app:boxCornerRadiusTopStart="20dp"
                app:boxCornerRadiusBottomEnd="20dp"
                app:boxCornerRadiusTopEnd="20dp"
                app:errorEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:inputType="text"
                    android:id="@+id/edtxt_staffNumber"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:hint="Staff Number"
                    android:imeOptions="actionNext"
                    android:maxLines="1"
                    android:autofillHints="username"
                    android:textSize="20sp"
                    android:textAlignment="center">

                </com.google.android.material.textfield.TextInputEditText>

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="30dp">

            </TextView>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_Password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxStrokeColor="@color/error_red"
                app:boxCornerRadiusBottomStart="20dp"
                app:boxCornerRadiusTopStart="20dp"
                app:boxCornerRadiusBottomEnd="20dp"
                app:boxCornerRadiusTopEnd="20dp"
                app:endIconMode="password_toggle"
                app:errorEnabled="true"
                app:errorIconDrawable="@null">

                <com.google.android.material.textfield.TextInputEditText
                    android:inputType="textPassword"
                    android:id="@+id/edtxt_Password"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:hint="Password"
                    android:imeOptions="actionDone"
                    android:maxLines="1"
                    android:autofillHints="password"
                    android:textSize="20sp"
                    android:textAlignment="center">

                </com.google.android.material.textfield.TextInputEditText>

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Opens a pop up that emails a reset-password link to the lecturer -->
            <TextView
                android:id="@+id/txtvw_forgotPassword"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_gravity="end"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="Forgot password?"
                android:textColor="@color/error_red"
                android:textSize="15sp"
                android:textStyle="bold">

            </TextView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="*Login will turn green if details correct*"
                android:textAlignment="center"
                android:textColor="@android:color/holo_green_dark"
                android:textStyle="bold">

            </TextView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_login"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:backgroundTint="@color/material_dynamic_neutral80"
                android:enabled="false"
                android:text="Login"
                android:textSize="20sp"
                android:textStyle="bold">

            </com.google.android.material.button.MaterialButton>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="30dp">

            </TextView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_ClearFields"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:backgroundTint="@color/error_red"
                android:text="X"
                android:textSize="20sp"
                android:textStyle="bold">

            </com.google.android.material.button.MaterialButton>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="16dp">

            </TextView>

            <!-- Takes the lecturer to the sign up page -->
            <TextView
                android:id="@+id/txtvw_signUpLink"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="I don't have an account. Sign me up"
                android:textColor="@color/error_red"
                android:textSize="16sp"
                android:textStyle="bold">

            </TextView>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
