<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_marginTop="12dp"
    android:layout_marginBottom="12dp"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".reportsPage">

    <LinearLayout
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_width="match_parent"
        android:layout_height="0dp">

        <!-- Trimester filter: "All Trimesters" or one trimester (filled in by reportsPage.java) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_reportTrimester"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:hint="Trimester"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="@color/error_red">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/actxt_reportTrimester"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:saveEnabled="false"
                android:textAlignment="center"
                android:textColor="?android:textColorPrimary"
                android:textSize="14sp">

            </com.google.android.material.textfield.MaterialAutoCompleteTextView>

        </com.google.android.material.textfield.TextInputLayout>

        <!-- The card takes all the height left above the button, in portrait and landscape -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/holo_green_dark"
                    android:textSize="30sp"
                    android:text="Tally Report"
                    android:textAlignment="center"
                    android:textColor="@color/white">

                </TextView>

                <!-- Column titles with sort up/down buttons (filled in by reportsPage.java). Stays visible while the rows scroll -->
                <LinearLayout
                    android:id="@+id/ll_reportHeader"
                    android:orientation="horizontal"
                    android:background="@color/error_red"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                </LinearLayout>

                <TextView
                    android:id="@+id/txtvw_noRecords"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:text="No student records yet."
                    android:textAlignment="center"
                    android:textColor="?android:textColorPrimary"
                    android:textSize="13sp"
                    android:visibility="gone">

                </TextView>

                <!-- Student rows (filled in by reportsPage.java). Scrolls up/down; columns always fit the screen width -->
                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:id="@+id/ll_reportRows"
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                    </LinearLayout>

                </ScrollView>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="10dp">

        </TextView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_generatePDF"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/error_red"
            android:text="Download Report (PDF)"
            android:textColor="@color/white">

        </com.google.android.material.button.MaterialButton>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
